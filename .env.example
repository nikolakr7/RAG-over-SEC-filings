# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. `.env.example` is committed, so anyone cloning the
# repo can see which variables they need without ever seeing your secrets.

# SEC requires a User-Agent identifying who you are, with a real contact.
# Requests without one get 403 Forbidden. Format: "project-name your@email.com"
SEC_USER_AGENT="baswe-1 research you@example.com"

# Azure OpenAI — filled in later this phase.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_CHAT_DEPLOYMENT=""
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=""
